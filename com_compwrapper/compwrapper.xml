<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
	<name>com_compwrapper</name>
	<author>Karsten Hausmann</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Karsten Hausmann</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>1.4.0</version>
	<description>COM_COMPWRAPPER_XML_DESCRIPTION</description>
	<namespace path="src">Hausi\Component\Compwrapper</namespace>

	<files folder="site">
		<folder>language</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages folder="site/language">
		<language tag="de-DE">de-DE/com_compwrapper.ini</language>
		<language tag="en-GB">en-GB/com_compwrapper.ini</language>
	</languages>

	<media destination="com_compwrapper" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<administration>
		<menu img="class:window-maximize">COM_COMPWRAPPER</menu>
		<files folder="administrator">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>language</folder>
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator/language">
			<language tag="de-DE">de-DE/com_compwrapper.ini</language>
			<language tag="de-DE">de-DE/com_compwrapper.sys.ini</language>
			<language tag="en-GB">en-GB/com_compwrapper.ini</language>
			<language tag="en-GB">en-GB/com_compwrapper.sys.ini</language>
		</languages>
	</administration>
</extension>
